/* ─── API ─── */
async function apiGet(entity) {
  const r = await fetchAuth(`${BASE}/api/states/${entity}`);
  if (!r.ok) return null;
  return r.json();
}
async function apiService(domain, service, data) {
  await fetchAuth(`${BASE}/api/services/${domain}/${service}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  });
}

/* ─── TOGGLE BOOLEAN ─── */
async function toggleBool(entity, cb) {
  await apiService('input_boolean', 'toggle', { entity_id: entity });
  setTimeout(() => refreshStates(), 300);
}

/* ─── BUILD MODULE CARDS ─── */
function buildModules(container, mods, color) {
  container.innerHTML = '';
  mods.forEach(m => {
    const div = document.createElement('div');
    div.className = 'mod-card color-' + (color || 'green') + (m.child ? ' mod-child' : '');
    div.dataset.entity = m.entity;
    div.innerHTML = `
      <div class="mod-info">
        <div class="mod-name">${m.name}</div>
        <div class="mod-desc">${m.desc}</div>
      </div>
      <label class="toggle" onclick="event.stopPropagation()">
        <input type="checkbox" data-entity="${m.entity}" onchange="toggleBool('${m.entity}', this)">
        <div class="toggle-track"></div>
      </label>`;
    container.appendChild(div);
  });
}

/* ─── DROITS D'ACCÈS AIDANTS ─── */
const DROITS_ENTITY = 'input_text.m10_droits_aidants';

async function apiGetAllStates() {
  const r = await fetchAuth(`${BASE}/api/states`);
  if (!r.ok) return [];
  return r.json();
}

async function loadDroits() {
  const s = await apiGet(DROITS_ENTITY);
  if (!s || !s.state || s.state === 'unknown') return {};
  try { return JSON.parse(s.state); } catch (e) { return {}; }
}

async function saveDroits(droits) {
  await apiService('input_text', 'set_value', { entity_id: DROITS_ENTITY, value: JSON.stringify(droits) });
}

/* ─── IDENTITÉ RÉELLE — WEBSOCKET auth/current_user (2026-08-15) ───
   Remplace le gate PIN (retiré — jugé ingérable par l'utilisateur, un PIN
   partagé donne accès à quiconque le connaît). Il n'existe pas d'endpoint
   REST "qui suis-je" fiable dans HA (/api/profile est mort, confirmé 404
   en direct — voir init() plus bas). Seul le WebSocket le permet :
   auth_required -> auth (token) -> auth_ok -> auth/current_user -> {id,
   name, is_admin, is_owner}. Ce `id` correspond exactement à
   person.<x>.attributes.user_id de la personne connectée — vérifié en
   direct. Voir m10_gestion_aidants.yaml pour le détail complet du mapping
   token -> user HA -> person.* -> droits. */
function wsCurrentUser(tok) {
  return new Promise((resolve, reject) => {
    const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const ws = new WebSocket(`${proto}//${window.location.host}/api/websocket`);
    let settled = false;
    const timer = setTimeout(() => {
      if (!settled) { settled = true; try { ws.close(); } catch(e) {} reject(new Error('timeout')); }
    }, 8000);
    ws.onmessage = (ev) => {
      let msg; try { msg = JSON.parse(ev.data); } catch (e) { return; }
      if (msg.type === 'auth_required') {
        ws.send(JSON.stringify({ type: 'auth', access_token: tok }));
      } else if (msg.type === 'auth_ok') {
        ws.send(JSON.stringify({ id: 1, type: 'auth/current_user' }));
      } else if (msg.type === 'auth_invalid') {
        if (!settled) { settled = true; clearTimeout(timer); ws.close(); reject(new Error('auth_invalid')); }
      } else if (msg.type === 'result' && msg.id === 1) {
        if (!settled) {
          settled = true; clearTimeout(timer); ws.close();
          if (msg.success) resolve(msg.result); else reject(new Error('ws_error'));
        }
      }
    };
    ws.onerror = () => { if (!settled) { settled = true; clearTimeout(timer); reject(new Error('ws_connection_error')); } };
  });
}

/* Retourne :
   - { admin:true, name } si owner/admin HA (accès total, jamais stocké en JSON)
   - { admin:false, mask, name } si un person.* est identifié (via attributes.user_id)
   - { admin:false, mask:0, name } si connecté mais aucun person.* lié (compte HA
     existe mais pas rattaché à une fiche Personne)
   - null si pas de token, token invalide, ou WS injoignable */
async function resolveAccess() {
  const tok = currentToken();
  if (!tok) return null;
  let user;
  try { user = await wsCurrentUser(tok); } catch (e) { return null; }
  if (user.is_admin || user.is_owner) return { admin: true, name: user.name };
  const allStates = await apiGetAllStates();
  const person = allStates.find(s => s.entity_id.startsWith('person.') && s.attributes && s.attributes.user_id === user.id);
  if (!person) return { admin: false, mask: 0, name: user.name };
  const droits = await loadDroits();
  const objectId = person.entity_id.replace('person.', '');
  return { admin: false, mask: droits[objectId] || 0, name: person.attributes.friendly_name || user.name };
}

// Bitmask complet — voir m10_gestion_aidants.yaml
const DROIT_BIT = { config: 1, messages: 2, calendrier: 4, video: 8, photos: 16, alertes: 32 };
const DROIT_ICON = { config: '🔧', messages: '⚙️', calendrier: '📅', video: '📺', photos: '📷', alertes: '🚨' };

async function buildDroits() {
  const list = document.getElementById('droits-list');
  list.innerHTML = '<div class="aidant-row"><div class="aidant-name" style="color:var(--text3)">Chargement…</div></div>';

  const [allStates, droits] = await Promise.all([apiGetAllStates(), loadDroits()]);
  const persons = allStates.filter(s => s.entity_id.startsWith('person.') && s.entity_id !== 'person.eric');

  if (persons.length === 0) {
    list.innerHTML = '<div class="aidant-row"><div class="aidant-name" style="color:var(--text3)">Aucun aidant trouvé</div></div>';
    return;
  }

  list.innerHTML = '';
  persons.forEach(p => {
    const objectId = p.entity_id.replace('person.', '');
    const name = p.attributes.friendly_name || objectId;
    const mask = droits[objectId] || 0;
    const row = document.createElement('div');
    row.className = 'aidant-row';
    row.style.cursor = 'default';
    const checks = Object.keys(DROIT_BIT).map(key => {
      const has = (mask & DROIT_BIT[key]) !== 0;
      return `<label class="droit-check ${has ? 'on' : ''}" data-person="${objectId}" data-droit="${key}" onclick="toggleDroit(this)">
        <input type="checkbox" ${has ? 'checked' : ''}>${DROIT_ICON[key]}
      </label>`;
    }).join('');
    row.innerHTML = `<div class="aidant-name">${escHtml(name)}</div>${checks}`;
    list.appendChild(row);
  });
}

async function toggleDroit(label) {
  event.stopPropagation();
  const objectId = label.dataset.person;
  const droitType = label.dataset.droit;
  const bit = DROIT_BIT[droitType];
  const droits = await loadDroits();
  const mask = droits[objectId] || 0;
  const has = (mask & bit) !== 0;
  droits[objectId] = has ? (mask & ~bit) : (mask | bit);
  if (droits[objectId] === 0) delete droits[objectId];
  label.classList.toggle('on', !has);
  await saveDroits(droits);
  toast(has ? `${droitType} retiré` : `${droitType} accordé`);
}

