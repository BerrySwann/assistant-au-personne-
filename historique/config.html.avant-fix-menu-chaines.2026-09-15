  { entity: 'input_boolean.module_m03_ecran_msg',   name: 'M03 — Bandeau Messages',  desc: 'Messages famille + agenda sur le kiosk', child: true },
  { entity: 'input_boolean.module_m04_calendrier',  name: 'M04 — Bandeau Calendrier', desc: 'Agenda et rendez-vous récurrents sur le kiosk', child: true },
  { entity: 'input_boolean.module_m31_kiosk_foto',  name: 'M09 — Écran Photos Famille', desc: 'Diaporama photos envoyées par email', child: true },
  { entity: 'input_boolean.module_m32_kiosk_zic',   name: 'M10 — Écran Musique',      desc: 'Lecture musique de la bibliothèque personnelle', child: true },
  { entity: 'input_boolean.module_m33_visio',        name: 'M11 — Écran Visioconférence', desc: 'Appel vidéo famille en un clic', child: true },
  { entity: 'input_boolean.module_m34_television',   name: 'M12 — Écran Télévision',   desc: 'Créneaux TV + retour photos auto', child: true },
  // M14 Repas retiré le 2026-08-16 (abandonné — aucun signal fiable, voir
  // m00_modules.yaml).
];
