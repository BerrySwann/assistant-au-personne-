/* ─── BUILD TV SESSIONS ─── */
function buildTVSessions() {
  const cont = document.getElementById('tv-sessions');
  cont.innerHTML = '';
  [1,2,3,4].forEach(n => {
    const div = document.createElement('div');
    div.className = 'session-card';
    div.innerHTML = `
      <div class="session-head">
        <label class="toggle" onclick="event.stopPropagation()">
          <input type="checkbox" data-entity="input_boolean.m34_session${n}_actif" onchange="toggleBool('input_boolean.m34_session${n}_actif', this)">
          <div class="toggle-track"></div>
        </label>
        <div class="session-label" style="color:#fff;flex:0 0 auto;">Session ${n}</div>
        <div class="chaine-wrap" onclick="event.stopPropagation()">
          <button type="button" class="chaine-btn" id="m34_s${n}_bouton" onclick="event.stopPropagation(); ouvrirChaines(${n});">
            <span id="m34_s${n}_val">…</span><span class="chev">▾</span>
          </button>
          <div class="chaine-liste" id="m34_s${n}_liste"></div>
        </div>
        <button class="btn-ok" onclick="event.stopPropagation(); runSession(${n})" title="Lancer">✓</button>
        <span id="sess-arrow-${n}" style="color:var(--text3);cursor:pointer;" onclick="toggleSession(${n})">›</span>
      </div>
      <div class="session-hours">
        <input type="time" class="field-input" id="m34_s${n}_debut" onchange="setDatetime('input_datetime.m34_session${n}_debut', this.value)">
        <span class="session-hours-sep">→</span>
        <input type="time" class="field-input" id="m34_s${n}_fin" onchange="setDatetime('input_datetime.m34_session${n}_fin', this.value)">
      </div>
      <div class="session-body" id="sess-body-${n}">
        <div class="field-row">
          <div class="field-label">URL YouTube</div>
          <input type="url" class="field-input" id="m34_s${n}_yt" placeholder="https://youtube.com/...">
          <button class="btn-save" onclick="saveText('input_text.m34_session${n}_youtube_url', 'm34_s${n}_yt')">Enregistrer</button>
        </div>
        <button class="btn-run" onclick="runSession(${n})">▶ Lancer session ${n}</button>
      </div>`;
    cont.appendChild(div);
  });
}

function toggleSession(n) {
  const body = document.getElementById('sess-body-' + n);
  const arrow = document.getElementById('sess-arrow-' + n);
  body.classList.toggle('open');
  arrow.textContent = body.classList.contains('open') ? '⌄' : '›';
}

