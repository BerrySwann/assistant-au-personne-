/* ─── API ACTIONS ─── */
async function setSelect(entity, option) {
  await apiService('input_select', 'select_option', { entity_id: entity, option });
  toast('✓ Sauvegardé');
}
/* 2026-09-14 : MENU CHAINES MAISON (remplace le <select> natif au popup incontrôlable) */
let _chaineOuverte = null;
function ouvrirChaines(n) {
  const liste = document.getElementById(`m34_s${n}_liste`);
  if (!liste) return;
  const etait = _chaineOuverte === n;
  fermerChaines();
  if (etait) return;
  liste.classList.add('ouvert');
  _chaineOuverte = n;
}
function fermerChaines() {
  document.querySelectorAll('.chaine-liste.ouvert').forEach(l => l.classList.remove('ouvert'));
  _chaineOuverte = null;
}
async function choisirChaine(n, val) {
  fermerChaines();
  const valEl = document.getElementById(`m34_s${n}_val`);
  if (valEl) valEl.textContent = val;
  document.querySelectorAll(`#m34_s${n}_liste .chaine-item`).forEach(it => {
    it.classList.toggle('actif', it.getAttribute('data-val') === val);
  });
  await setSelect(`input_select.m34_session${n}_chaine`, val);
}
document.addEventListener('click', () => { if (_chaineOuverte !== null) fermerChaines(); });
async function setDatetime(entity, time) {
  const [h, m] = time.split(':');
  await apiService('input_datetime', 'set_datetime', { entity_id: entity, time: `${h}:${m}:00` });
  toast('✓ Sauvegardé');
}
async function saveText(entity, inputId) {
  const val = document.getElementById(inputId).value;
  await apiService('input_text', 'set_value', { entity_id: entity, value: val });
  toast('✓ Sauvegardé');
}
async function saveNumber(entity, inputId) {
  const val = parseFloat(document.getElementById(inputId).value);
  await apiService('input_number', 'set_value', { entity_id: entity, value: val });
  toast('✓ Sauvegardé');
}
async function runSession(n) {
  await apiService('script', 'm34_lancer_session', { num: n });
  toast('▶ Session ' + n + ' lancée');
}

/* ─── REFRESH STATES ─── */
async function refreshStates() {
  const allBools = [
    ...GENERAL_MODS, ...SECURITE_MODS, ...AIDANTS, ...CONFORT_MODS,
    ...ENV_MODS, ...FAMILLE_MODS,
    { entity: 'input_boolean.m34_session1_actif' },
    { entity: 'input_boolean.m34_session2_actif' },
    { entity: 'input_boolean.m34_session3_actif' },
    { entity: 'input_boolean.m34_session4_actif' },
    { entity: 'input_boolean.m20_medoc_matin_actif' },
    { entity: 'input_boolean.m20_medoc_midi_actif' },
    { entity: 'input_boolean.m20_medoc_soir_actif' },
    { entity: 'input_boolean.m20_medoc_couche_actif' },
  ];
  for (const m of allBools) {
    const s = await apiGet(m.entity);
    if (!s) continue;
    const cb = document.querySelector(`input[data-entity="${m.entity}"]`);
    if (cb) cb.checked = s.state === 'on';
  }

  // Chaînes TV (menu maison depuis 2026-09-14 — remplace le <select> natif)
  for (const n of [1,2,3,4]) {
    const sel = await apiGet(`input_select.m34_session${n}_chaine`);
    if (sel) {
      const valEl = document.getElementById(`m34_s${n}_val`);
      const listEl = document.getElementById(`m34_s${n}_liste`);
      if (valEl) valEl.textContent = sel.state || '—';
      if (listEl && listEl.children.length === 0) {
        (sel.attributes.options || []).forEach(o => {
          const it = document.createElement('div');
          it.className = 'chaine-item' + (o === sel.state ? ' actif' : '');
          it.textContent = o;
          it.setAttribute('data-val', o);
          it.onclick = (ev) => { ev.stopPropagation(); choisirChaine(n, o); };
          listEl.appendChild(it);
        });
      } else if (listEl) {
        listEl.querySelectorAll('.chaine-item').forEach(it => {
          it.classList.toggle('actif', it.getAttribute('data-val') === sel.state);
        });
      }
    }
    const deb = await apiGet(`input_datetime.m34_session${n}_debut`);
    if (deb) { const el = document.getElementById(`m34_s${n}_debut`); if (el) el.value = (deb.state || '').slice(0,5); }
    const fin = await apiGet(`input_datetime.m34_session${n}_fin`);
    if (fin) { const el = document.getElementById(`m34_s${n}_fin`); if (el) el.value = (fin.state || '').slice(0,5); }
    const yt = await apiGet(`input_text.m34_session${n}_youtube_url`);
    if (yt) { const el = document.getElementById(`m34_s${n}_yt`); if (el) el.value = yt.state !== 'unknown' ? yt.state : ''; }
  }

  // Visio (Google Meet) : section retirée le 2026-08-16 (visio maison WebRTC).
  // Plus de champ input_text.m33_visio_url à rafraîchir ici.

  // [RETIRÉ 2026-08-18] Avancé TV — section "Réglages avancés TV" supprimée
  // (son seul champ, Browser ID TV, ne servait plus à rien).

  // Rappels médicaments (M13) : heures des 4 zones + durée d'affichage
  for (const z of ['matin', 'midi', 'soir', 'couche']) {
    const s = await apiGet(`input_datetime.m20_medoc_${z}`);
    if (s) { const el = document.getElementById(`medoc_${z}_time`); if (el && s.state && s.state !== 'unknown') el.value = s.state.slice(0,5); }
  }
  const durState = await apiGet('input_number.m20_medoc_duree_min');
  if (durState) { const el = document.getElementById('medoc_duree'); if (el && durState.state !== 'unknown') el.value = durState.state; }

  // Rappels médicaments (M14) — masqués si module_m20_medoc off
  const m14State = await apiGet('input_boolean.module_m20_medoc');
  const medocBlock = document.getElementById('medoc-detail-block');
  if (medocBlock) medocBlock.style.display = (m14State && m14State.state === 'on') ? '' : 'none';

  // Sessions TV (M34) — masquées si module_m34_television off
  const m34State = await apiGet('input_boolean.module_m34_television');
  const tvBlock = document.getElementById('tv-sessions-block');
  if (tvBlock) tvBlock.style.display = (m34State && m34State.state === 'on') ? '' : 'none';

  // Plage horaire visio (M33) — masquée si module_m33_visio off
  const m33State = await apiGet('input_boolean.module_m33_visio');
  const visioPlage = document.getElementById('visio-plage-block');
  if (visioPlage) visioPlage.style.display = (m33State && m33State.state === 'on') ? '' : 'none';
  const visioDeb = await apiGet('input_datetime.m33_horaire_debut');
  if (visioDeb) { const el = document.getElementById('visio_horaire_debut'); if (el && visioDeb.state && visioDeb.state !== 'unknown') el.value = visioDeb.state.slice(0,5); }
  const visioFin = await apiGet('input_datetime.m33_horaire_fin');
  if (visioFin) { const el = document.getElementById('visio_horaire_fin'); if (el && visioFin.state && visioFin.state !== 'unknown') el.value = visioFin.state.slice(0,5); }

  // ─── Vérifications hardware (grise le toggle si capteur absent de Z2M) ───
  const hwM05 = await apiGet('binary_sensor.bouton_sos_action');
  setHardwareDisabled('input_boolean.module_m10_sos',
    !hwM05 || hwM05.state === 'unavailable' || hwM05.state === 'unknown');

  const hwM06 = await apiGet('binary_sensor.capteur_lit_contact');
  setHardwareDisabled('input_boolean.module_m11_capteur_lit',
    !hwM06 || hwM06.state === 'unavailable' || hwM06.state === 'unknown');

  const hwM13 = await apiGet('sensor.th_sdb_humidity');
  setHardwareDisabled('input_boolean.module_m22_douche',
    !hwM13 || hwM13.state === 'unavailable' || hwM13.state === 'unknown');

  const hwM16 = await apiGet('binary_sensor.contact_porte_entree_contact');
  setHardwareDisabled('input_boolean.module_m13_porte_ext',
    !hwM16 || hwM16.state === 'unavailable' || hwM16.state === 'unknown');

  const [pirC, pirCo, pirS] = await Promise.all([
    apiGet('input_boolean.m02_pir_cuisine_actif'),
    apiGet('input_boolean.m02_pir_couloir_actif'),
    apiGet('input_boolean.m02_pir_sdb_actif'),
  ]);
  const anyPir = [pirC, pirCo, pirS].some(p => p && p.state === 'on');
  setHardwareDisabled('input_boolean.module_m17_lumiere_nuit', !anyPir);

  applyM08Dependency();
  await refreshApercu();
}

/* ─── HARDWARE DISABLED — grise + bloque le toggle si capteur absent de Z2M ─── */
function setHardwareDisabled(entity, disabled) {
  const card = document.querySelector(`.mod-card[data-entity="${entity}"]`);
  if (!card) return;
  card.classList.toggle('mod-hw-disabled', disabled);
  const cb = card.querySelector('input[type="checkbox"]');
  if (cb) cb.disabled = disabled;
}

/* ─── M08 DEPENDENCY — désactive visuellement les autres modules Kiosk TV si M08 est off ─── */
function applyM08Dependency() {
  const m08cb = document.querySelector('input[data-entity="input_boolean.module_m30_kiosk_ecran"]');
  const m08on = m08cb && m08cb.checked;
  const container = document.getElementById('confort-modules');
  if (!container) return;
  container.querySelectorAll('.mod-card').forEach(card => {
    if (card.dataset.entity === 'input_boolean.module_m30_kiosk_ecran') return; // M08 lui-même : toujours actif
    card.classList.toggle('mod-disabled', !m08on);
  });
}

/* ─── APERÇU KIOSK — miroir en direct des modules (tous les cas) ─── */
const APERCU_MODS = {
  m03: 'input_boolean.module_m03_ecran_msg',      // Bandeau Messages
  m04: 'input_boolean.module_m04_calendrier',     // Bandeau Calendrier
  m09: 'input_boolean.module_m31_kiosk_foto',     // Écran Photos Famille
  m10: 'input_boolean.module_m32_kiosk_zic',      // Écran Musique
  m11: 'input_boolean.module_m33_visio',          // Écran Visioconférence
  m12: 'input_boolean.module_m34_television',     // Écran Télévision
};
async function refreshApercu() {
  const elCal  = document.getElementById('kp-cal');
  const elMsg  = document.getElementById('kp-msg');
  const elMain = document.getElementById('kp-main');
  if (!elMain) return;

  const m08s = await apiGet('input_boolean.module_m30_kiosk_ecran');
  const m08 = !!(m08s && m08s.state === 'on');

  const etats = {};
  for (const [k, entity] of Object.entries(APERCU_MODS)) {
    const s = await apiGet(entity);
    etats[k] = !!(s && s.state === 'on');
  }

  // Cas 1 : Écran Général Kiosk (M08) coupé → tout disparaît sauf l'horloge
  elCal.style.display  = (m08 && etats.m04) ? '' : 'none';
  elMsg.style.display  = (m08 && etats.m03) ? '' : 'none';
  elMain.style.display = m08 ? '' : 'none';
  if (!m08) return;

  // Cas 2 : nom de chaque module de la liste → rouge quand son module est coupé
  elMain.querySelectorAll('[data-mod]').forEach(el => {
    el.classList.toggle('kp-off', !etats[el.dataset.mod]);
  });
}

/* ─── TABS ─── */
let currentTab = null;
function switchTab(n) {
  currentTab = n;
  // Menu -> page : la liste verticale disparaît, le contenu de l'onglet s'affiche
  document.querySelector('.tabs').style.display = 'none';
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', +t.dataset.tab === n));
  document.querySelectorAll('.tab-panel').forEach((p,i) => p.classList.toggle('active', i===n));
  // Le titre de l'en-tête reprend le nom du bouton touché
  const tab = document.querySelector('.tab[data-tab="' + n + '"]');
  document.getElementById('header-title').textContent = tab ? tab.textContent.trim() : '⚙️ Configuration';
  window.scrollTo(0, 0);
}
function showMenu() {
  currentTab = null;
  document.querySelector('.tabs').style.display = '';
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.getElementById('header-title').textContent = '⚙️ Configuration';
  window.scrollTo(0, 0);
}
function handleBack() {
  if (currentTab !== null) { showMenu(); return; }
  if (window.parent.closeConfig) window.parent.closeConfig();
  else window.location.href = '/local/aidant.html';
}

/* ─── OUTILS ─── */
function haNav(path) {
  window.location.href = BASE + path;
}

// 2026-08-15 (audit sécurité) : buildDroits() injecte
// person.attributes.friendly_name (donnée HA réelle, modifiable en direct
// par n'importe quel compte ayant accès à HA) dans innerHTML sans
// échappement — seul point de ce fichier où une valeur dynamique (pas un
// tableau JS codé en dur) atterrit dans du HTML. Reprise de la même
// fonction que aidant.html (déjà en place là-bas).
function escHtml(s) {
  return String(s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ─── TOAST ─── */
function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 1800);
}

/* ─── INIT ─── */
async function init() {
  if (!currentToken()) { window.location.href = '/local/aidant.html'; return; }

  // Username : /api/profile n'existe pas côté HA (404 confirmé en direct,
  // code mort de longue date) — on utilise le nom déjà résolu par
  // resolveAccess() dans runAccessGate() (CURRENT_USER_NAME), pas de 2e appel.
  if (CURRENT_USER_NAME) document.getElementById('ha-user').textContent = CURRENT_USER_NAME;

  buildModules(document.getElementById('general-modules'), GENERAL_MODS, 'green');
  buildAidants();
  await buildDroits();
  buildModules(document.getElementById('securite-modules'), SECURITE_MODS, 'amber');
  buildMedoc();
  buildModules(document.getElementById('confort-modules'), CONFORT_MODS, 'purple');
  buildTVSessions();
  buildModules(document.getElementById('env-modules'), ENV_MODS, 'cyan');
  buildModules(document.getElementById('famille-modules'), FAMILLE_MODS, 'pink');

  await refreshStates();
  setInterval(refreshStates, 30000);
}

/* ─── GATE D'ACCÈS RÉEL (2026-08-15, remplace le gate PIN) ───
   init() n'est plus appelé directement — il faut d'abord identifier qui
   est réellement connecté (resolveAccess()) et vérifier le droit 🔧
   (config, bit 1). Inactif en mode ?only=tv (déjà protégé par le droit
   📺 de video.html en amont — voir m10_gestion_aidants.yaml). */
let CURRENT_USER_NAME = '';

function unlockGate() {
  document.getElementById('access-gate').style.display = 'none';
  document.getElementById('app-content').style.display = 'block';
  init();
}

// 2026-08-15 (correctif, audit sécurité #3 — Hermes) : `?only=tv` faisait
// `unlockGate()` SANS AUCUNE vérification — un accès direct par URL (pas
// via video.html) donnait accès à init() en entier (droits, réglages,
// visio…), le mode `only-tv` ne masquant que visuellement via CSS. Les
// fonctions (toggleDroit, saveDroits, saveText…) restaient appelables via
// la console quel que soit ce qui était affiché. Le raisonnement d'origine
// ("déjà protégé par video.html en amont") supposait que video.html était
// le SEUL chemin d'accès, ce qui n'était jamais vérifié ici. Corrigé :
// même appel à resolveAccess(), mais avec le droit 📺 video (bit 8) au lieu
// de 🔧 config en mode `only=tv` — exactement le droit déjà requis par
// video.html, donc plus aucun raccourci possible par URL directe.
async function runAccessGate() {
  const requiredBit = (ONLY_MODE === 'tv') ? DROIT_BIT.video : DROIT_BIT.config;

  const icon = document.getElementById('gate-icon');
  const title = document.getElementById('gate-title');
  const sub = document.getElementById('gate-sub');

  const access = await resolveAccess();

  if (access && (access.admin || (access.mask & requiredBit))) {
    CURRENT_USER_NAME = access.name || '';
    unlockGate();
    return;
  }

  icon.textContent = '⛔';
  title.textContent = 'Accès refusé';
  const droitLabel = (ONLY_MODE === 'tv') ? '📺 Vidésio' : '🔧 Config';
  sub.textContent = access
    ? `Ton compte (${access.name || '?'}) n'a pas le droit ${droitLabel}. Demande à l'installateur de le cocher dans Configuration → Sécurité → Droits d'accès.`
    : "Impossible de t'identifier (pas de compte HA propre lié à ta fiche Personne). Voir Paramètres → Personnes → Autoriser la connexion.";
}

runAccessGate();
</script>
</body>
</html>

