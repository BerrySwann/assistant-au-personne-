<div class="toast" id="toast"></div>

<script>
const BASE = window.location.origin;
const token = localStorage.getItem('ha_token') || '';

// ── MODE "ONLY" (pages dédiées, 2026-08-15) ─────────────────
// ?only=tv (utilisé par video.html en iframe) : isole #only-tv-block
// (Sessions TV), cache le header/tabs/reste (voir <style>). Sans effet
// si le paramètre est absent — comportement normal inchangé.
const ONLY_MODE = new URLSearchParams(window.location.search).get('only');
if (ONLY_MODE === 'tv') document.documentElement.classList.add('only-tv');
function haSessionToken() {
  try {
    const raw = localStorage.getItem('hassTokens');
    if (!raw) return '';
    const t = JSON.parse(raw);
    if (!t || !t.access_token) return '';
    if (t.expires && Date.now() > t.expires) return '';
    return t.access_token;
  } catch (e) { return ''; }
}
function currentToken() { return haSessionToken() || token; }

// 2026-08-15 (correctif, propagé depuis photos.html) : le token de session
// HA (hassTokens, ~30 min) peut être invalide/expiré sans que notre test
// d'expiration le détecte de façon fiable (confirmé par un log HA "Login
// attempt failed... invalid authentication" pendant le débogage de l'upload
// photo). fetchAuth() retente automatiquement avec l'AUTRE source de token
// en cas de 401, au lieu de rester bloqué sur un token de session pourri
// alors qu'un token longue durée valide existe en repli.
async function fetchAuth(url, opts) {
  opts = opts || {};
  const baseHeaders = opts.headers || {};
  async function attempt(tok) {
    const headers = Object.assign({}, baseHeaders, { Authorization: 'Bearer ' + tok });
    return fetch(url, Object.assign({}, opts, { headers }));
  }
  const first = currentToken();
  let r = await attempt(first);
  if (r.status === 401) {
    const alt = (first === token) ? haSessionToken() : token;
    if (alt && alt !== first) r = await attempt(alt);
  }
  return r;
}

/* ─── DATA ─── */
